# Production values. Set DATA_RESIDENCY_CONFIRMED only after verifying the server is physically in Russia.
APP_ENV=production
DATA_RESIDENCY_CONFIRMED=RU
# Set these to 1 only after the corresponding compliance steps are actually complete.
RKN_NOTIFICATION_FILED=0
PD_DOCUMENTS_APPROVED=0
PROCESSOR_TERMS_CONFIRMED=0
# Keep 0 until the RKN notification and every launch requirement are complete.
PORTAL_DATA_PROCESSING_ENABLED=0
COOKIE_SECURE=1
HOST=0.0.0.0
PORT=8000
# Primary storage: sqlite for local development, tabrica for the Russian cloud database.
PORTAL_STORAGE=tabrica
TABRICA_API_TOKEN=replace-in-server-environment-only
TABRICA_DATABASE_ID=0
TABRICA_USERS_TABLE_ID=0
TABRICA_SESSIONS_TABLE_ID=0
TABRICA_APPLICATIONS_TABLE_ID=0

# Used only when PORTAL_STORAGE=sqlite.
PORTAL_DB_PATH=/var/lib/kryak/portal.db
